# Solo para desarrollo local. Reemplaza las credenciales antes de compartir o desplegar.
CDCI_DATABASE_PASSWORD=cdci_dev_only
CDCI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CDCI_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
CDCI_FRONTEND_ORIGIN=http://localhost:3000
CDCI_REGISTRATION_ENABLED=true
CDCI_COOKIE_SECURE=false
CDCI_COOKIE_SAME_SITE=lax
CDCI_RUN_RETENTION_DAYS=90
CDCI_GITHUB_CLIENT_ID=
CDCI_GITHUB_CLIENT_SECRET=
CDCI_GITHUB_CALLBACK_URL=http://localhost:8080/api/integrations/github/callback
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
CDCI_GITHUB_TOKEN_ENCRYPTION_KEY=
# Genera un secreto aleatorio largo y compártelo solo con el backend y el worker confiable.
# El compose runner necesita el mismo valor en su entorno y en el backend.
CDCI_RUNNER_TOKEN=
CDCI_RUNNER_API_URL=http://host.docker.internal:8080
CDCI_RUNNER_ID=cdci-local-runner
CDCI_RUNNER_DEFAULT_IMAGE=node:22-bookworm-slim
CDCI_RUNNER_STEP_TIMEOUT_SECONDS=1800
CDCI_RUNNER_RUN_TIMEOUT_SECONDS=21600
CDCI_RUNNER_MEMORY_MB=2048
CDCI_RUNNER_CPU_COUNT=1
CDCI_RUNNER_PIDS_LIMIT=256
